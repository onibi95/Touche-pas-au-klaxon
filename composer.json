{
    "require": {
        "php": "^8.2",
        "izniburak/router": "^3.1",
        "scssphp/scssphp": "^1.12"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse app",
        "build-css": "@php scripts/compile-scss.php",
        "watch-css": "@php scripts/watch-scss.php",
        "dev": "@watch-css"
    },
    "config": {
        "platform-check": false
    }
}
